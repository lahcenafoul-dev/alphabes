# Database
DATABASE_URL="postgresql://user:password@localhost:5432/alphabes"

# Auth
NEXTAUTH_URL="https://alphabes.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# App
NEXT_PUBLIC_APP_URL="https://alphabes.com"

# PayPal Subscriptions (docs/paypal-plan.md). Locally: sandbox values only.
# In production these are Cloudflare secrets, never in a file.
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# Written by scripts/paypal/setup-plans.mjs. PAYPAL_PLAN_TEST (daily) is sandbox-only.
PAYPAL_PLAN_MONTHLY=""
PAYPAL_PLAN_YEARLY=""
PAYPAL_PLAN_TEST=""

# Object storage (S3-compatible) for worksheet PDFs
S3_BUCKET_NAME="alphabes-worksheets"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="xxx"
S3_SECRET_ACCESS_KEY="xxx"

# Analytics / Search Console
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXX"
GOOGLE_SITE_VERIFICATION="xxx"
