{
  "name": "alphabes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed-stories.ts",
    "generate:worksheets": "tsx scripts/generate-worksheets.ts",
    "validate:worksheets": "tsx scripts/validate-worksheets.ts",
    "fiches:fr": "tsx scripts/fiches-fr/generate.ts",
    "fichas:es": "tsx scripts/fichas-es/generate.ts",
    "atividades:pt": "tsx scripts/atividades-pt/generate.ts",
    "bundles:en": "tsx scripts/bundles-en/generate.ts",
    "previews:thumbs": "node scripts/preview-thumbs.mjs",
    "tts:histoires": "tsx scripts/tts-histoires.ts",
    "postinstall": "prisma generate",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.9.5",
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-neon": "5.19.1",
    "@prisma/client": "5.19.1",
    "bcryptjs": "2.4.3",
    "jspdf": "^4.2.1",
    "next": "15.5.26",
    "next-auth": "4.24.15",
    "next-intl": "^4.14.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.15",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.26",
    "postcss": "8.4.41",
    "prisma": "5.19.1",
    "tailwindcss": "3.4.10",
    "tsx": "4.19.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5",
    "wrangler": "^4.143.0"
  },
  "allowScripts": {
    "@prisma/client@5.19.1": true,
    "@prisma/engines@5.19.1": true,
    "prisma@5.19.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true,
    "unrs-resolver@1.12.2": true
  }
}
